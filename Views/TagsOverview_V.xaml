<UserControl x:Class="TagExplorer.Views.TagsOverview_V"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TagExplorer.Views"
             xmlns:viewModels="clr-namespace:TagExplorer.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
             Background="{DynamicResource MaterialDesign.Brush.Background}"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded"
             d:DataContext="{d:DesignInstance Type=viewModels:TagsOverview_VM, IsDesignTimeCreatable=True}">
    
   
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl 
                ItemsSource="{Binding Path=TagViewsModels}"
                Margin="10 10 10 10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:Tag_V DataContext="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer >
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" />

        <Grid Grid.Column="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="Edit Tag"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
            <Expander Grid.Row="1"
                HorizontalAlignment="Stretch"
                materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,10,5"
                IsExpanded="True"
                Header="Properties">
                <StackPanel
                    Margin="20,5,20,5"
                    Orientation="Vertical"
                    TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                    <TextBox
                        Margin="0 5 0 10"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.HasLeadingIcon="False"
                        materialDesign:HintAssist.Hint="Name"
                        Text="{Binding Path=SelectedTag.Name}"
                        d:Text="Tag Name"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    />
                    <TextBox
                        Margin="0 5 0 0"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="Description"
                        Text="{Binding Path=SelectedTag.Description}"
                        d:Text="Tag Description"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    />

                    <TextBox
                        Margin="0 15 0 0"
                        materialDesign:HintAssist.Hint="Aliases"
                        Text="{Binding Path=SelectedTagAliasString}"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                    />

                    <Label
                        Content="Color"
                        Margin="0 10 0 0"/>
                    <ItemsControl 
                        ItemsSource="{Binding Path=ColorButtonVMs}"
                        Padding="0 2 0 0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:ColorButton_V DataContext="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    

                </StackPanel>
            </Expander>

            <Expander Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,10,10,5"
                      Header="Child Tags">
                <ItemsControl 
                    ItemsSource="{Binding Path=SelectedTagChildrenVMs}"
                    Margin="10 10 10 10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:Tag_V DataContext="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>

            <Expander Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,10,10,5"
                      Header="Meta Tags">
            </Expander>
            <Button
                Grid.Row="5"
                Content="Save Changes"
                Command="{Binding Path=SaveTagChangesCommand}"></Button>
        </Grid>
    </Grid>
</UserControl>
