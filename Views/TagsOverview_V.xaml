<UserControl x:Class="TagExplorer.Views.TagsOverview_V"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
     xmlns:local="clr-namespace:TagExplorer.Views"
     xmlns:viewModels="clr-namespace:TagExplorer.ViewModels"
     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
     xmlns:c="clr-namespace:TagExplorer.Converters"
     mc:Ignorable="d"
     TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
     Background="{DynamicResource MaterialDesign.Brush.Background}"
     d:DesignHeight="450" d:DesignWidth="800"
     d:DataContext="{d:DesignInstance Type=viewModels:TagsOverview_VM, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <c:InverseBooleanConverter x:Key="InverseBool"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <c:BooleanToString x:Key="BoolToEditModeString" TrueString="New Tag" FalseString="Edit Tag"/>
        <c:BooleanToString x:Key="BoolToSaveButtonString" TrueString="Create Tag" FalseString="Save Changes"/>
        <Style x:Key="TagOverviewChipStyle" TargetType="materialDesign:Chip" BasedOn="{StaticResource MaterialDesignOutlineChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding Path=Color.HexCode}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=IsSelected}" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Chip.OutlineBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
            Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            <ScrollViewer 
                Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    ItemsSource="{Binding Path=TagVMs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:TagBase_V
                                DataContext="{Binding}"
                                IsPickUpable="False"
                                ChipStyle="{StaticResource TagOverviewChipStyle}"
                                ClickCommand="{Binding PressTagCommand}">
                                <local:TagBase_V.Style>
                                    <Style TargetType="local:TagBase_V">
                                        <Style.Triggers>
                                            <!-- Hidden subfolder tags: barely visible; orphaned ones: warning colour. -->
                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:TagBase_V.Style>
                            </local:TagBase_V>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <DockPanel Grid.Row="2" LastChildFill="True">
                <CheckBox
                    DockPanel.Dock="Left"
                    Margin="0 0 10 0"
                    VerticalAlignment="Center"
                    Content="Show subfolder tags"
                    ToolTip="Tags of the subfolders of folder rules: generated (italic) and customised ones"
                    IsChecked="{Binding Path=ShowAutoCreatedTags}" />
                <CheckBox
                    DockPanel.Dock="Left"
                    Margin="0 0 10 0"
                    VerticalAlignment="Center"
                    Content="Show hidden tags"
                    ToolTip="Subfolder tags you hid; select one and press the eye button to show it again"
                    IsChecked="{Binding Path=ShowHiddenTags}" />
                <Button
                    Content="Add Tag"
                    Command="{Binding Path=AddTagCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                </Button>
            </DockPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" />

        <Grid Grid.Column="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                Text="{Binding Path=NewTagEdit, Converter={StaticResource BoolToEditModeString}}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
            <Expander Grid.Row="1"
                HorizontalAlignment="Stretch"
                materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,10,5"
                IsExpanded="True"
                Header="Properties">
                <StackPanel
                    Margin="20,5,20,5"
                    IsEnabled="{Binding Path=EditEnabled}"
                    Orientation="Vertical"
                    TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Margin="0 5 0 10"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.HasLeadingIcon="False"
                            materialDesign:HintAssist.Hint="Name"
                            Text="{Binding Path=Name,
                                UpdateSourceTrigger=PropertyChanged}"
                            d:Text="Tag Name"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Margin="0"
                            Padding="0"
                            Command="{Binding SelectIconPressedCommand}"
                            Background="{Binding Path=Color.HexCode}"
                            BorderBrush="White">
                            <materialDesign:PackIcon
                                HorizontalContentAlignment="Center"
                                Width="22" Height="22"
                                Kind="Edit" />
                        </Button>
                    </Grid>
                   
                    <TextBox
                        Margin="0 5 0 0"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="Description"
                        Text="{Binding Path=Description, UpdateSourceTrigger=PropertyChanged}"
                        d:Text="Tag Description"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    />

                    <TextBox
                        Margin="0 15 0 0"
                        materialDesign:HintAssist.Hint="Aliases"
                        Text="{Binding Path=AliasString, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                    />

                    <TextBox
                        Margin="0 10 0 0"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="Short code (max 8)"
                        Text="{Binding Path=ShortCode, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        MaxLength="8" />

                    <Label
                        Content="Color"
                        Margin="0 10 0 0"/>
                    <ItemsControl 
                        ItemsSource="{Binding Path=ColorButtonVMs}"
                        Padding="0 2 0 0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:ColorButton_V DataContext="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <Expander Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,10,10,5"
                      Header="Child Tags">
                <ItemsControl 
                    ItemsSource="{Binding Path=ChildrenVMs}"
                    Margin="10 10 10 10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:TagBase_V
                                DataContext="{Binding}"
                                IsPickUpable="False"
                                ChipStyle="{StaticResource TagOverviewChipStyle}"
                                ClickCommand="{Binding PressTagCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>

            <Expander
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,10,10,5"
                Header="Meta Tags">
            </Expander>

            <Grid 
                Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Content="{Binding Path=NewTagEdit, Converter={StaticResource BoolToSaveButtonString}}"
                    Command="{Binding SaveTagChangesCommand}"
                    Style="{StaticResource MaterialDesignRaisedSecondaryLightButton}">
                </Button>

                <!-- Only for stored (customised or hidden) subfolder tags. -->
                <Button
                    Grid.Column="1"
                    Margin="10 0 0 0"
                    Content="Reset to generated"
                    ToolTip="Drop the changes to this subfolder tag and use the generated one again"
                    Visibility="{Binding Path=CanResetToGenerated, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{Binding Path=ResetToGeneratedCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />

                <Button
                    Grid.Column="3"
                    Width="32"
                    Margin="0"
                    Padding="0"
                    IsEnabled="{Binding Path=SelectedTag.IsSystemTag,
                        Converter={StaticResource InverseBool}, 
                        FallbackValue=False}"
                    Command="{Binding Path=DeleteTagCommand}"
                    ToolTip="{Binding Path=DeleteButtonToolTip}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <!-- Delete; for subfolder tags Hide (eye off) or Show again (eye). -->
                    <materialDesign:PackIcon
                        HorizontalContentAlignment="Center"
                        Width="20" Height="20"
                        Kind="{Binding Path=DeleteButtonIcon}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
