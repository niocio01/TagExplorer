<UserControl x:Class="TagExplorer.Views.IconButton_V"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TagExplorer.Views"
             xmlns:views="clr-namespace:TagExplorer.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="40"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=views:IconButton_V, IsDesignTimeCreatable=True}">
    <Grid>
        <Button
            BorderThickness="0"
            Height="40" Width="40"
            ToolTip="{Binding Path=IconName, ElementName=Root}"
            Padding="0"
            Margin="0"
            Command="{Binding Path=ButtonClickedCommand, ElementName=Root}"
            Background="Transparent"
            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
            <Button.InputBindings>
                <MouseBinding
                    Gesture="Shift+LeftClick" Command="{Binding ButtonShiftClickedCommand, ElementName=Root}"/>
            </Button.InputBindings>
            <Border
                BorderThickness="2"
                CornerRadius="5">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="BorderBrush"
                                        Value="white" />
                            </Trigger>
                            <DataTrigger
                                    Binding="{Binding Path=IsFavourite, ElementName=Root}" Value="True">
                                <Setter Property="Background" Value="#c4a102"/>
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </Border.Style>
                <materialDesign:PackIcon
                    HorizontalContentAlignment="Center"
                    Width="35" Height="35"
                    Kind="{Binding IconName, ElementName=Root}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Button>
    </Grid>
</UserControl>
