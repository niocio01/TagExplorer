<UserControl x:Class="TagExplorer.Views.Tag_V2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TagExplorer.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:TagExplorer.Models"
             mc:Ignorable="d" 
             x:Name="Root"
             
             d:DataContext="{d:DesignInstance Type=models:FilterTag, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <Style x:Key="Style" TargetType="materialDesign:Chip" BasedOn="{StaticResource MaterialDesignOutlineChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=FilterType}" Value="MustHave">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=FilterType}" Value="MustNotHave">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=FilterType}" Value="null">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Chip.OutlineBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        
        <materialDesign:Chip
            Content="{Binding Path=Name}"
            d:Content="Tag Name"
            IconBackground="{Binding Path=Color.HexCode}"
            d:IconBackground="#FF0000"
            Command="{Binding Path=ToggleMustHaveFilterCommand}"
            Style="{StaticResource Style}"
            ToolTip="{Binding Path=Description}">
            <materialDesign:Chip.InputBindings>
                <MouseBinding Gesture="RightClick" Command="{Binding ToggleMustNotHaveFilterCommand}" />
            </materialDesign:Chip.InputBindings>
            <materialDesign:Chip.Icon>
                <materialDesign:PackIcon
                    Kind="{Binding Path=IconName}"
                    d:Kind="numeric1CircleOutline"/>
            </materialDesign:Chip.Icon>
        </materialDesign:Chip>
        <Grid
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Height="14"
            Width="14"
            Margin="0 2 2 0"
            d:Visibility="Visible">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=FilterType}" Value="{x:Static models:FilterTag+FilterTypes.MustNotHave}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=FilterType}" Value="{x:Static models:FilterTag+FilterTypes.MustHave}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Ellipse 
                Width="11"
                Height="11"
                Fill="{DynamicResource MaterialDesign.Brush.Background}" />

            <materialDesign:PackIcon 
                Margin="0 0 0 0"
                Padding="0 0 0 0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Kind="CheckCircle" d:Foreground="LimeGreen">
                <materialDesign:PackIcon.Style>
                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=FilterType}" Value="{x:Static models:FilterTag+FilterTypes.MustNotHave}">
                                <Setter Property="Kind" Value="CloseCircle" />
                                <Setter Property="Foreground" Value="Red" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=FilterType}" Value="{x:Static models:FilterTag+FilterTypes.MustHave}">
                                <Setter Property="Kind" Value="CheckCircle" />
                                <Setter Property="Foreground" Value="LimeGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
        </Grid>
    </Grid>
</UserControl>
