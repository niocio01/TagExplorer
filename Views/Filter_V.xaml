<UserControl x:Class="TagExplorer.Views.Filter_V"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TagExplorer.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:root="clr-namespace:TagExplorer"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="50">
    
    <Grid
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Height="14"
        Width="14"
        Margin="0 2 2 0"
        d:Visibility="Visible">
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=FilterType}" Value="{x:Static root:FilterTypes.Required}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=FilterType}" Value="{x:Static root:FilterTypes.Disallowed}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Ellipse 
            Width="11"
            Height="11"
            Fill="{DynamicResource MaterialDesign.Brush.Background}" />

        <materialDesign:PackIcon 
            Margin="0 0 0 0"
            Padding="0 0 0 0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            d:Kind="CheckCircle" d:Foreground="LimeGreen">
            <materialDesign:PackIcon.Style>
                <Style TargetType="{x:Type materialDesign:PackIcon}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=FilterType}" Value="{x:Static root:FilterTypes.Disallowed}">
                            <Setter Property="Kind" Value="CloseCircle" />
                            <Setter Property="Foreground" Value="Red" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=FilterType}" Value="{x:Static root:FilterTypes.Required}">
                            <Setter Property="Kind" Value="CheckCircle" />
                            <Setter Property="Foreground" Value="LimeGreen" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:PackIcon.Style>
        </materialDesign:PackIcon>
    </Grid>
</UserControl>
