<UserControl x:Class="TagExplorer.Views.TagListDroppable_V"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TagExplorer.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="150"
             d:DesignWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Expander
        HorizontalAlignment="Stretch"
        materialDesign:ExpanderAssist.HorizontalHeaderPadding="0, 0, 0, 0"
        Header="{Binding HeaderText, ElementName=Root}"
        IsExpanded="{Binding IsExpanded, ElementName=Root}">
        <Grid>
            <TextBlock
                Margin="0 10"
                Text="{Binding NoSelectionText, ElementName=Root}"
                Opacity="0.75"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        <Grid x:Name="TagsDropZone"
              Margin="0 10"
              AllowDrop="True"
              Background="Transparent"
              DragOver="TagsDropZone_DragOver"
              Drop="TagsDropZone_Drop">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem, ElementName=Root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ItemsControl
                x:Name="ItemTagsList"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding ItemsSource, ElementName=Root}"
                d:ItemsSource="{d:SampleData ItemCount=3}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:TagBase_V
                            DataContext="{Binding}"
                            IsPickUpable="False">
                            <local:TagBase_V.Style>
                                <Style TargetType="local:TagBase_V">
                                    <Style.Triggers>
                                        <!-- Virtual tags come from a folder above, rules tag only the subfolders. -->
                                        <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRule}" Value="True">
                                            <Setter Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:TagBase_V.Style>
                            <local:TagBase_V.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Header="Remove tag"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding RemoveTagCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding}" />
                                    <MenuItem
                                        Header="Kind"
                                        Visibility="{Binding CanChangeMode, Converter={StaticResource BoolToVisibility}}"
                                        ItemsSource="{Binding ModeOptions}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                                                <Setter Property="Command" Value="{Binding Command}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem
                                        Header="{Binding GoToSourceHeader}"
                                        Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding GoToSourceCommand}" />
                                    <MenuItem
                                        Header="{Binding RemoveFromSourceHeader}"
                                        Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding RemoveFromSourceCommand}" />
                                </ContextMenu>
                            </local:TagBase_V.ContextMenu>
                        </local:TagBase_V>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid
                x:Name="DropHintOverlay"
                d:Visibility="Visible"
                IsHitTestVisible="False">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ItemTagsList, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Rectangle
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinHeight="40"
                    Fill="{DynamicResource MaterialDesignDarkSeparatorBackground}"
                    Stroke="{DynamicResource MaterialDesignLightSeparatorBackground}"
                    StrokeThickness="2"
                    StrokeDashArray="1.0 1.0"
                    RadiusX="8"
                    RadiusY="8" />

                <TextBlock
                    Text="No tags applied to selected item. Drop tags here to add one."
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ItemTagsList, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
        </Grid>
    </Expander>
</UserControl>
