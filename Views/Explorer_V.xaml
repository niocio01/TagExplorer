<UserControl x:Class="TagExplorer.Views.Explorer_V"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
     xmlns:local="clr-namespace:TagExplorer.Views"
     xmlns:viewModels="clr-namespace:TagExplorer.ViewModels"
     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
     xmlns:c="clr-namespace:TagExplorer.Converters"
     mc:Ignorable="d"
     TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
     Background="{DynamicResource MaterialDesign.Brush.Background}"
     d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:Explorer_VM />
    </UserControl.DataContext>
        <UserControl.Resources>
        <c:InverseBooleanConverter x:Key="InverseBool"/>
        <c:BooleanToString x:Key="BoolToEditModeString" TrueString="New Tag" FalseString="Edit Tag"/>
        <c:BooleanToString x:Key="BoolToSaveButtonString" TrueString="Create Tag" FalseString="Save Changes"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
            
        <ListBox
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding SelectedItem}"
            ItemsSource="{Binding Path=CurrentFolderItems}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Kind="{Binding Path=IconString}"
                            Margin="0 0 10 0" />
                        <TextBlock
                            Text="{Binding Path=Name}"
                            d:Text="Item text that is fairly long.txt"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
            
        
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" />

        <Grid Grid.Column="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                <Button
                    Grid.Column="2"
                    Width="32"
                    Margin="0"
                    Padding="0"
                    IsEnabled="{Binding Path=SelectedTag.IsSystemTag,
                        Converter={StaticResource InverseBool}, 
                        FallbackValue=False}"
                    Command="{Binding Path=DeleteTagCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <materialDesign:PackIcon
                        HorizontalContentAlignment="Center"
                        Width="20" Height="20"
                        Kind="Delete" />
                </Button>
            
        </Grid>
    </Grid>
</UserControl>
