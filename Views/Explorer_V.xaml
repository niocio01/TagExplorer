<UserControl x:Class="TagExplorer.Views.Explorer_V"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
     xmlns:local="clr-namespace:TagExplorer.Views"
     xmlns:viewModels="clr-namespace:TagExplorer.ViewModels"
     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
     xmlns:c="clr-namespace:TagExplorer.Converters"
     mc:Ignorable="d"
     TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
     Background="{DynamicResource MaterialDesign.Brush.Background}"
     d:DesignHeight="800" d:DesignWidth="1500">
    <UserControl.DataContext>
        <viewModels:Explorer_VM />
    </UserControl.DataContext>
        <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatLightButton}">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            </Style>
            <c:InverseBooleanConverter x:Key="InverseBool"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <c:FolderToBreadcrumbIconConverter x:Key="BreadcrumbIconConverter" />
        </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TopBar" 
            Grid.Row="0"
            Margin="5 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                VerticalContentAlignment="Center"
                Margin="0 0 -5 0"
                Padding="5"
                IsEnabled="{Binding Path=GoBackAvailable}"
                Command="{Binding Path=GoBackCommand}">
                <materialDesign:PackIcon
                    Kind="ArrowLeft"
                    Width="20" Height="20"
                    Padding="0"
                    Margin="0 0 0 0"
                    VerticalAlignment="Center" />
            </Button>
            <Button
                Grid.Column="1"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                VerticalContentAlignment="Center"
                Margin="0 0 -5 0"
                Padding="5"
                IsEnabled="{Binding Path=GoForwardAvailable}"
                Command="{Binding Path=GoForwardCommand}">
                <materialDesign:PackIcon
                    Kind="ArrowRight"
                    Width="20" Height="20"
                    Padding="0"
                    Margin="0 0 0 0"
                    VerticalAlignment="Center" />
            </Button>
            <Rectangle
                Grid.Column="3"
                Fill="{DynamicResource MaterialDesignLightSeparatorBackground}"
                Width="2"
                Grid.Row="1"
                Margin="10 0 5 0"/>
            <Button
                Grid.Column="4"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            VerticalContentAlignment="Center"
            Margin="0 0 -5 0"
            Padding="5"
            Command="{Binding Path=BreadcrumbHomeClickedCommand}">
            <materialDesign:PackIcon
                Grid.Column="0"
                Kind="HomeOutline"
                Width="20" Height="20"
                Padding="0"
                Margin="0 0 0 0"
                VerticalAlignment="Center" />
            </Button>
            <ItemsControl
                Grid.Column="5"
                Padding="5 4 5 4"
                x:Name="Breadcrumb"
                ItemsSource="{Binding Breadcrumbs}"
                d:ItemsSource="{d:SampleData ItemCount=5}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Kind="ChevronRight"
                                Visibility="{Binding Path=HasParentFolder, Converter={StaticResource BooleanToVisibility}}"
                                Width="20" Height="20"
                                Padding="0"
                                Margin="0 0 0 0"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"
                                Margin="0"
                                Padding="5"
                                CommandParameter="{Binding .}"
                                Command="{Binding Path=DataContext.BreadcrumbClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                >
                                <TextBlock
                                    Text="{Binding Name}"
                                    d:Text="Folder_Name"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Rectangle
                Grid.Column="6"
                Fill="{DynamicResource MaterialDesignLightSeparatorBackground}"
                Width="2"
                Grid.Row="1"
                Margin="10 0 5 0"/>
            <ToggleButton
                Grid.Column="7"
                Margin="0 0 0 0"
                Height="30"
                Width="30"
                Content="{materialDesign:PackIcon Kind=FileTreeOutline,                                                         Size=21}"
                IsChecked="{Binding Path=DoRecursiveSearch}"
                d:IsChecked="True"
                Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                ToolTip="Search inside subfolders"
              />

            <ToggleButton
                Grid.Column="8"
                Margin="5 0 0 0"
                Height="30"
                Width="30"
                Content="{materialDesign:PackIcon Kind=FolderOutline,                                                         Size=21}"
                IsChecked="{Binding Path=ShowFolders}"
                d:IsChecked="True"
                Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                ToolTip="Show folders in results"
            />

            <ToggleButton
                Grid.Column="9"
                Margin="5 0 5 0"
                Height="30"
                Width="30"
                Content="{materialDesign:PackIcon Kind=FileHidden,                                                         Size=21}"
                IsChecked="{Binding Path=ShowHiddenFiles}"
                Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                ToolTip="Show hidden files" />
        </Grid>
        <Rectangle
            Fill="{DynamicResource MaterialDesignLightSeparatorBackground}"
            Height="2"
            Grid.Row="1"
            Margin="0"/>
        <Grid x:Name="Conent"
            Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid Name="Filters"
                Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10 10 10 0"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="Filters"
                    HorizontalAlignment="Center"/>
                <Grid
                    Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="10 0 0 5"
                        Style="{StaticResource MaterialDesignBody1TextBlock}"
                        Text="Tags"/>
                    <TextBlock
                        Grid.Column="1"
                        Margin="5 0 10 3"
                        Style="{StaticResource MaterialDesignBody1TextBlock}">
                        <Run Text="(" />
                        <Run Text="{Binding RequiredTagFilterCount}"
                             d:Text="3"
                             Foreground="LimeGreen" />
                        <Run Text="/" />
                        <Run Text="{Binding DisallowedTagFilterCount}"
                             d:Text="2"
                             Foreground="Red" />
                        <Run Text=")" />
                    </TextBlock>
                    <Button
                        Grid.Column="3"
                        Padding="8 0 8 0"
                        Command="{Binding Path=ClearTagsFiltersCommand}">
                        <materialDesign:PackIcon
                            Kind="ClearCircleOutline"
                            Height="18"
                            Width="18"/>
                    </Button>
                </Grid>
                
                <ScrollViewer 
                    Grid.Row="3" 
                    Margin="10 0 10 0"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        ItemsSource="{Binding Path=AllFilterTags}"
                        d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:Tag_V2 DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <GridSplitter 
                    ResizeDirection="Rows"
                    Margin="0 10 0 10"
                    Grid.Row="4" Height="3" HorizontalAlignment="Stretch" />
                <Grid
                    Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                    Grid.Column="0"
                    Margin="10 0 0 5"
                    Style="{StaticResource MaterialDesignBody1TextBlock}"
                    Text="FileType"/>
                    <TextBlock
                        Grid.Column="1"
                        Margin="5 0 10 3"
                        Style="{StaticResource MaterialDesignBody1TextBlock}">
                        <Run Text="(" />
                        <Run Text="{Binding RequiredExtentionFilterCount}"
                             d:Text="3"
                             Foreground="LimeGreen" />
                        <Run Text="/" />
                        <Run Text="{Binding DisallowedExtentionFilterCount}"
                             d:Text="2"
                             Foreground="Red" />
                        <Run Text=")" />
                    </TextBlock>
                    <Button
                        Grid.Column="3"
                        Padding="8 0 8 0"
                        Command="{Binding Path=ClearExtentionFiltersCommand}">
                        <materialDesign:PackIcon
                            Kind="ClearCircleOutline"
                            Height="18"
                            Width="18"/>
                    </Button>
                </Grid>
                <ScrollViewer 
                    Grid.Row="6"
                    VerticalScrollBarVisibility="Auto"
                    d:VerticalScrollBarVisibility="Visible">
                    <ItemsControl
                        ItemsSource="{Binding Path=AllFilterExtention_VMs}"
                        d:ItemsSource="{d:SampleData ItemCount=10}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:ExtentionButton_V DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" />

            <local:FileList_V
                Grid.Column="2"
                DataContext="{Binding FileList}" />

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" />

            <Grid Name="ItemProperties"
                Grid.Column="4"
                Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                    Text="{Binding Path=FileList.SelectedItem.Name, FallbackValue='No Item Selected' }"
                    d:Text="Explorer Item"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>

                <Expander Grid.Row="2"
                          HorizontalAlignment="Stretch"
                          materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,10,10,5"
                          Header="Child Tags">
                    <ItemsControl 
                        ItemsSource="{Binding Path=SelectedItemTags}"
                        d:ItemsSource="{d:SampleData ItemCount=3}"
                        Margin="10 10 10 10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:Tag_V DataContext="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>



            </Grid>
        </Grid>
        <Rectangle
            Fill="{DynamicResource MaterialDesignLightSeparatorBackground}"
            Height="2"
            Grid.Row="4"
            Margin="0"/>
        <Grid x:Name="BottomBar"
            Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="10 4 0 4"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <materialDesign:PackIcon
                    Kind="FolderOutline"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center" />
                <TextBlock
                    Margin="4 0 10 0"
                    VerticalAlignment="Center"
                    Text="{Binding FileList.FilteredFolderCount, StringFormat={}{0:N0}}" />
                <materialDesign:PackIcon
                    Kind="FileOutline"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center" />
                <TextBlock
                    Margin="4 0 0 0"
                    VerticalAlignment="Center"
                    Text="{Binding FileList.FilteredFileCount, StringFormat={}{0:N0}}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Margin="0 4 10 4"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <materialDesign:PackIcon
                    Kind="FolderOutline"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center" />
                <TextBlock
                    Margin="4 0 10 0"
                    VerticalAlignment="Center"
                    Text="{Binding FileList.ScannedFolderCount, StringFormat={}{0:N0}}" />
                <materialDesign:PackIcon
                    Kind="FileOutline"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center" />
                <TextBlock
                    Margin="4 0 0 0"
                    VerticalAlignment="Center"
                    Text="{Binding FileList.ScannedFileCount, StringFormat={}{0:N0}}" />

                <materialDesign:PackIcon
                    Kind="FileTreeOutline"
                    Width="16"
                    Height="16"
                    Margin="12 0 0 0"
                    VerticalAlignment="Center" />
                <TextBlock
                    Margin="4 0 0 0"
                    VerticalAlignment="Center"
                    Text="{Binding FileList.ScannedDepth}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
