          <mxGeometry x="1630" y="305" width="190" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="hot1" value="Potential weakness:\ncache rebuild is triggered repeatedly around filter rebuilds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#ff0000;dashed=1;fontColor=#990000" vertex="1" parent="1">
          <mxGeometry x="960" y="430" width="290" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="hot2" value="Potential weakness:\nGetEffectiveTagIdsByPath uses assignment x item nested loops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#ff0000;dashed=1;fontColor=#990000" vertex="1" parent="1">
          <mxGeometry x="1270" y="430" width="310" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="hot3" value="Potential weakness:\nhidden-attribute IO may run before cheap filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#ff0000;dashed=1;fontColor=#990000" vertex="1" parent="1">
          <mxGeometry x="610" y="430" width="320" height="70" as="geometry"/>
