          <mxGeometry x="1270" y="170" width="310" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="db" value="DB (EF Core)\nTagAssignments + Tags" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1630" y="175" width="190" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="rebuild" value="RebuildFilteredItems()\nsnapshot = CurrentFolderItems.ToList()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="290" y="300" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="fileList" value="FileList.RebuildFilteredItemsAsync\nfor each item => FileList.Matches(...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="610" y="300" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="matchOrder" value="Match order today:\n1) folder show/depth\n2) hidden check (can hit File.GetAttributes)\n3) extension\n4) tag match callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="960" y="300" width="320" height="95" as="geometry"/>
        </mxCell>

