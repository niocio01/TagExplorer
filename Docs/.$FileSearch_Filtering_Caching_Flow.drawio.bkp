<mxfile host="app.diagrams.net" modified="2026-03-20T00:00:00.000Z" agent="GitHub Copilot" version="24.7.17">
  <diagram id="filesearch-flow" name="File Search / Filtering / Caching">
    <mxGraphModel dx="1530" dy="905" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
