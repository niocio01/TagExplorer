          <mxGeometry x="30" y="580" width="360" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="cacheKey" value="Cache key format\n{rootPath}|r:{includeSubdirectories}|h:{includeHiddenFiles}\nExamples for same root:\n...|r:True|h:False / ...|r:True|h:True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="410" y="580" width="430" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="cacheOps" value="Cache behavior\n- TryGetCachedAllItems: exact key lookup\n- SearchAsync completion: writes snapshot into key\n- Invalidate(rootPath): currently removes raw rootPath only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
