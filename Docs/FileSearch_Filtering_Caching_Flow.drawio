          <mxGeometry x="960" y="175" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tagSvc" value="TagAssignmentService.GetEffectiveTagIdsByPath&#xa;Build _manualTagIdsByPath" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="1270" y="170" width="310" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db" value="DB (EF Core)&#xa;TagAssignments + Tags" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="1630" y="175" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rebuild" value="RebuildFilteredItems()&#xa;snapshot = CurrentFolderItems.ToList()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="290" y="300" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fileList" value="FileList.RebuildFilteredItemsAsync&#xa;for each item =&gt; FileList.Matches(...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="610" y="300" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="matchOrder" value="Match order today:&#xa;1) folder show/depth&#xa;2) hidden check (can hit File.GetAttributes)&#xa;3) extension&#xa;4) tag match callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="960" y="300" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tagMatch" value="MatchesTagFilters(item)&#xa;lookup _manualTagIdsByPath[path]&#xa;required/disallowed checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="1320" y="305" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="filtered" value="FilteredFolderItems&#xa;(bound list shown in UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="1050" y="590" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hot1" value="Potential weakness:&#xa;cache rebuild is triggered repeatedly around filter rebuilds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#ff0000;dashed=1;fontColor=#990000" parent="1" vertex="1">
          <mxGeometry x="960" y="430" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hot2" value="Potential weakness:&#xa;GetEffectiveTagIdsByPath uses assignment x item nested loops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#ff0000;dashed=1;fontColor=#990000" parent="1" vertex="1">
          <mxGeometry x="1270" y="430" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hot3" value="Potential weakness:&#xa;hidden-attribute IO may run before cheap filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#ff0000;dashed=1;fontColor=#990000" parent="1" vertex="1">
          <mxGeometry x="610" y="430" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="detailTitle" value="Detailed cache structure + filesystem actions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cacheStruct" value="_cache (ConcurrentDictionary&lt;string, List&lt;ExplorerItem&gt;&gt;)&#xa;Value = full snapshot for one search mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="30" y="580" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cacheKey" value="Cache key format&#xa;{rootPath}&#124;r:{includeSubdirectories}&#124;h:{includeHiddenFiles}&#xa;Meaning: r = recursive, h = include hidden files&#xa;Examples (same root C:\Work):&#xa;C:\Work&#124;r:True&#124;h:False&#xa;C:\Work&#124;r:True&#124;h:True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="410" y="580" width="430" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cacheOps" value="Cache behavior&#xa;- TryGetCachedAllItems: exact key lookup&#xa;- SearchAsync completion: writes snapshot into key&#xa;- Invalidate(rootPath): currently removes raw rootPath only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="860" y="580" width="430" height="100" as="geometry" />
        </mxCell>
        <mxCell id="invalidateWeakness" value="Potential weakness:&#xa;Invalidate(rootPath) may miss composite keys&#xa;(stale entries can remain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#ff0000;dashed=1;fontColor=#990000" vertex="1" parent="1">
          <mxGeometry x="1310" y="585" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fsLoop" value="EnumerateItems(rootFolder, recursive, hidden)&#xa;Traversal: Stack&lt;string&gt; pending (depth-first style)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="30" y="710" width="360" height="80" as="geometry" />
        </mxCell>
