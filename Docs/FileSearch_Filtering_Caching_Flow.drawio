          <mxGeometry x="610" y="60" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="searchDisk" value="ItemSearchService.SearchAsync&#xa;filesystem scan + progress callbacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="610" y="170" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="currentItems" value="CurrentFolderItems&#xa;(all discovered items for scope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" parent="1" vertex="1">
          <mxGeometry x="960" y="70" width="270" height="80" as="geometry" />
        </mxCell>
