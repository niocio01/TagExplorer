          <mxGeometry x="410" y="710" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fsFiles" value="Per folder:&#xa;Directory.EnumerateFiles(currentPath)&#xa;Create File model + yield" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="760" y="710" width="300" height="80" as="geometry" />
